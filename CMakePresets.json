{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/firmware/app/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "GATEWAY_FIRMWARE": "app"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "BootDebug",
            "inherits": "Debug",
            "toolchainFile": "${sourceDir}/firmware/bootloader/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "GATEWAY_FIRMWARE": "bootloader"
            }
        },
        {
            "name": "BootSizeCheck",
            "inherits": "BootDebug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "CMAKE_C_FLAGS_MINSIZEREL": "-Os -g3"
            }
        },
        {
            "name": "BootReceiveTest",
            "inherits": "BootSizeCheck",
            "cacheVariables": {
                "CMAKE_C_FLAGS_MINSIZEREL": "-Os -g3 -DDEBUG",
                "BOOT_PACKAGE_RECEIVE_TEST": "ON",
                "BOOT_FLASH_READ_DIAGNOSTIC": "ON"
            }
        },
        {
            "name": "BootRecoveryTest",
            "inherits": "BootReceiveTest",
            "cacheVariables": {
                "BOOT_FLASH_READ_DIAGNOSTIC": "OFF"
            }
        },
        {
            "name": "AppDebug",
            "inherits": "Debug",
            "cacheVariables": {
                "GATEWAY_FIRMWARE": "app",
                "GATEWAY_APP_LINKER_SCRIPT": "${sourceDir}/firmware/app/STM32F407xx_APP.ld",
                "GATEWAY_APP_VECTOR_OFFSET": "0x00010000"
            }
        },
        {
            "name": "M3Test",
            "inherits": "Debug",
            "cacheVariables": {
                "GATEWAY_ENABLE_M2": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "BootDebug",
            "configurePreset": "BootDebug"
        },
        {
            "name": "BootSizeCheck",
            "configurePreset": "BootSizeCheck"
        },
        {
            "name": "BootReceiveTest",
            "configurePreset": "BootReceiveTest"
        },
        {
            "name": "BootRecoveryTest",
            "configurePreset": "BootRecoveryTest"
        },
        {
            "name": "AppDebug",
            "configurePreset": "AppDebug"
        },
        {
            "name": "M3Test",
            "configurePreset": "M3Test"
        }
    ]
}
